# ==============================================================================
# KUMPUL BACKEND ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE (SUPABASE POSTGRESQL TRANSACTION POOLER)
# Catatan: Gunakan connection string port 6543 (Transaction Mode Pooler)
# Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (MIDTRANS SANDBOX)
# Dapatkan kredensial Sandbox dari Dashboard Midtrans: https://dashboard.sandbox.midtrans.com
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (VERIFIKASI DOKUMEN BATCH KOMODITAS & OCR)
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com
# Model yang direkomendasikan: gemini-2.5-flash (cepat, multimodal, akurat untuk dokumen/OCR)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GEMINI_MODEL="gemini-2.5-flash"
