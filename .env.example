# ==========================================
# KONFIGURASI ENVIRONMENT KUMPUL BACKEND
# ==========================================

# 1. Database PostgreSQL (Supabase Transaction Pooler Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# 2. Server Port
PORT=3030

# 3. Autentikasi JWT (HMAC-SHA256 Secret)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# 4. Google Gemini AI API Key (Verifikasi Mutu & Legalitas Dokumen Batch Tags)
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 5. Midtrans Payment Gateway Sandbox / Production
MIDTRANS_SERVER_KEY="SB-Mid-server-YourMidtransServerKey"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YourMidtransClientKey"
MIDTRANS_IS_PRODUCTION=false
